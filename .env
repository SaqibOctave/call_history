PORT=8790

# Logging (error, warn, info, debug)
LOG_LEVEL=info
LOG_TO_FILE=false

# Request body size limit
BODY_LIMIT=10mb

# JWT
JWT_ACCESS_SECRET=octavebytes
JWT_REFRESH_SECRET=octavebytes_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookie
COOKIE_HTTP_ONLY=true
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict
COOKIE_MAX_AGE_DAYS=7

# Timezone for report date grouping (must match your local timezone)
REPORT_TIMEZONE=Asia/Karachi

# PostgreSQL
DB_HOST=84.46.251.98
DB_PORT=5433
DB_USER=faraz
DB_PASSWORD=mypass
DB_NAME=faraz




SCRAPER_PROVIDER=playwright
SCRAPER_TIMEOUT_MS=30000

FIRECRAWL_API_KEY=your_firecrawl_api_key
# MCP_PLAYWRIGHT_COMMAND / MCP_PLAYWRIGHT_ARGS / MCP_FETCH_COMMAND / MCP_FETCH_ARGS /
# MCP_FIRECRAWL_COMMAND / MCP_FIRECRAWL_ARGS — only needed if overriding the defaults above

OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini


# How much of the scraped page ends up in the flow's role_messages:
#   summary - OpenAI condenses it to ~FLOW_SUMMARY_WORD_LIMIT words
 (cheap, fast, small prompt)
#   full    - the scraped content itself is used as-is, no LLM call
FLOW_CONTENT_MODE=summary
FLOW_SUMMARY_WORD_LIMIT=500
# Hard cap on how much scraped content is used either way (chars). In "summary" mode
# this is also how much gets sent to OpenAI per request.
FLOW_MAX_CONTENT_CHARS=60000